{"manifest":{"apiVersion":2,"id":"community.watch-together","name":"Watch Together / 视频同看","version":"2.0.0","author":"Huddle-Up-Forge","license":"AGPL-3.0-only","description":"Watch a video together with synchronized playback, seeking, speed and late joining.","scopes":["server","instance"],"client":{"entry":"client/index.html"},"server":{"entry":"server/main.mjs"}},"files":{"client/base.css":{"encoding":"utf8","data":":root{color-scheme:light;--bg:#f3f5f9;--surface:#fff;--raised:#f5f7fb;--text:#202c42;--muted:#69768d;--line:#dfe5ef;--accent:#6554d7;--soft:#efedff;--good:#16795d;--danger:#bd344d;--shadow:0 16px 48px #263b6210}html[data-theme=dark]{color-scheme:dark;--bg:#121722;--surface:#1b2332;--raised:#222d3e;--text:#ecf1fb;--muted:#a0aec4;--line:#354158;--accent:#b1a5ff;--soft:#302c4b;--good:#7bdeb7;--danger:#ff9eb0;--shadow:0 16px 48px #0002}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px/1.6 system-ui,sans-serif}button,input,select{font:inherit}button{cursor:pointer}button:disabled{opacity:.45;cursor:default}button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--accent);outline-offset:3px}main{max-width:1140px;margin:auto;padding:clamp(18px,4vw,40px)}.masthead{display:flex;align-items:start;justify-content:space-between;gap:20px;margin-bottom:26px}.eyebrow{font-size:10px;font-weight:800;letter-spacing:.18em;color:var(--accent);text-transform:uppercase}h1{font-size:clamp(25px,4vw,34px);letter-spacing:-.04em;line-height:1.2;margin:12px 0}h2{font-size:16px;margin:0 0 14px}p{margin:8px 0;color:var(--muted)}.connection{display:flex;align-items:center;gap:7px;white-space:nowrap;font-size:11px;color:var(--muted);background:var(--surface);border:1px solid var(--line);padding:7px 10px;border-radius:20px}.connection i{width:6px;height:6px;background:var(--danger);border-radius:50%}.connection[data-online=true] i{background:var(--good)}.grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:20px}.card{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:24px;min-width:0;box-shadow:var(--shadow)}.full{grid-column:1/-1}.primary,.secondary,.danger{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid var(--line);border-radius:10px;padding:10px 16px;text-decoration:none;line-height:1.4;min-height:42px}.primary{background:var(--accent);color:var(--surface);border-color:var(--accent);font-weight:700}.secondary{background:var(--raised);color:var(--text)}.danger{background:transparent;color:var(--danger)}.row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.between{justify-content:space-between}.muted{color:var(--muted);font-size:12px}.notice{padding:12px 16px;border:1px solid var(--line);background:var(--soft);border-radius:10px;margin:0 0 20px;overflow-wrap:anywhere}.notice.error{color:var(--danger)}[hidden]{display:none!important}label{display:grid;gap:7px;color:var(--muted);font-size:12px}input:not([type=range]),select{min-width:0;width:100%;border:1px solid var(--line);border-radius:9px;background:var(--raised);color:var(--text);padding:10px 12px}input[type=range]{width:100%;accent-color:var(--accent)}.pill{font-size:10px;font-weight:700;letter-spacing:.05em;padding:4px 8px;background:var(--soft);color:var(--accent);border-radius:6px}.peer{display:flex;align-items:center;gap:12px;padding:12px 0;border-top:1px solid var(--line)}.avatar{display:grid;place-items:center;width:36px;height:36px;flex:none;background:var(--soft);color:var(--accent);border-radius:12px;font-weight:750}.peer-name{flex:1;overflow-wrap:anywhere;min-width:0}.empty{padding:28px 8px;text-align:center;color:var(--muted)}progress{width:100%;height:8px;accent-color:var(--accent);border:0;margin:18px 0}.filename{font-weight:700;overflow-wrap:anywhere}.stat-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin:20px 0}.stat-grid b{display:block;font-size:18px;font-variant-numeric:tabular-nums}.stat-grid span{font-size:11px;color:var(--muted)}.footer{margin-top:20px;font-size:11px;color:var(--muted)}@media(max-width:650px){.grid{grid-template-columns:minmax(0,1fr)}.card{padding:18px}.masthead{flex-direction:column;gap:8px}.stat-grid{gap:7px}.stat-grid b{font-size:15px}}\n"},"client/i18n.mjs":{"encoding":"utf8","data":"export const copies={\n en:{title:'Press play. Watch together.',lead:'One shared timeline, wherever everyone is watching.',online:'Connected',offline:'Reconnecting…',emptyVideo:'Add a direct video URL to start a session.',join:'Allow playback on this device',play:'Play for everyone',pause:'Pause for everyone',timeline:'Shared playback position',speed:'Playback speed',mute:'Mute locally',unmute:'Unmute locally',volume:'Local volume',fullscreen:'Full screen',participants:'Watching together',host:'Host',you:'You',everyone:'Everyone can control playback',hostMode:'Playback is controlled by the host',handoff:'Pass hosting to',transfer:'Pass control',lateJoin:'Late arrivals automatically catch up. Volume and browser playback permission stay local.',source:'Video source',url:'Direct video URL',placeholder:'https://media.example.com/video.mp4',load:'Load for everyone',urlNote:'Use a browser-playable MP4 / WebM URL, not a video website’s watch page. Everyone must be able to access it.',privacy:'Only playback state is synchronized. Each browser loads the video directly; signed URLs are visible to participants.',synced:'In sync',waiting:'Waiting for video',buffering:'Buffering locally',blocked:'Click to allow playback',failed:'Video unavailable',error:'Operation failed: {code}',STATE_CHANGED:'Someone else updated playback. The latest state has been applied.',HOST_ONLY:'Only the host can change shared playback.',INVALID_URL:'Enter an HTTP or HTTPS video URL without account credentials.',NO_VIDEO:'Load a video first.',MEDIA_ERROR:'The browser could not play this source. Check the URL, codec and access permissions.',REVISION:'Revision {value}'},\n zh:{title:'按下播放，一起观看',lead:'无论身在何处，都在同一条时间线上。',online:'已连接',offline:'正在重新连接…',emptyVideo:'添加可直接播放的视频地址，开始同看。',join:'允许在本机播放',play:'为所有人播放',pause:'为所有人暂停',timeline:'共享播放进度',speed:'播放倍速',mute:'本机静音',unmute:'取消本机静音',volume:'本机音量',fullscreen:'全屏',participants:'同看成员',host:'主持人',you:'你',everyone:'所有成员均可控制播放',hostMode:'由主持人控制播放',handoff:'将主持权交给',transfer:'交接控制',lateJoin:'新加入的成员会自动同步进度。音量和浏览器播放许可仅影响本机。',source:'视频来源',url:'视频直链',placeholder:'https://media.example.com/video.mp4',load:'为所有人加载',urlNote:'使用浏览器支持的 MP4 / WebM 直链，而非视频网站的播放页面；所有成员都需要有访问权限。',privacy:'插件只同步播放状态，视频由各浏览器直接加载。带签名的视频地址会对同看成员可见。',synced:'已同步',waiting:'等待视频',buffering:'本机缓冲中',blocked:'点击允许播放',failed:'无法播放视频',error:'操作失败：{code}',STATE_CHANGED:'其他成员刚刚更新了播放，已同步最新状态。',HOST_ONLY:'只有主持人可以更改共享播放。',INVALID_URL:'请输入有效的 HTTP / HTTPS 视频地址，不要在地址中填写账号密码。',NO_VIDEO:'请先加载视频。',MEDIA_ERROR:'浏览器无法播放此来源，请检查地址、编码和访问权限。',REVISION:'状态版本 {value}'},\n de:{title:'Starten. Gemeinsam ansehen.',lead:'Eine gemeinsame Zeitleiste, egal wo ihr seid.',online:'Verbunden',offline:'Verbindung wird erneuert…',emptyVideo:'Eine direkte Video-URL hinzufügen.',join:'Wiedergabe auf diesem Gerät erlauben',play:'Für alle abspielen',pause:'Für alle pausieren',timeline:'Gemeinsame Wiedergabeposition',speed:'Geschwindigkeit',mute:'Lokal stummschalten',unmute:'Lokalen Ton einschalten',volume:'Lokale Lautstärke',fullscreen:'Vollbild',participants:'Gemeinsam dabei',host:'Gastgeber',you:'Du',everyone:'Alle dürfen die Wiedergabe steuern',hostMode:'Der Gastgeber steuert die Wiedergabe',handoff:'Gastgeber wechseln',transfer:'Steuerung übergeben',lateJoin:'Später beitretende Nutzer werden synchronisiert. Lautstärke und Wiedergabeerlaubnis bleiben lokal.',source:'Videoquelle',url:'Direkte Video-URL',placeholder:'https://media.example.com/video.mp4',load:'Für alle laden',urlNote:'Browserfähige MP4-/WebM-URL verwenden, keine Videoseite. Alle benötigen Zugriff.',privacy:'Nur der Wiedergabestatus wird synchronisiert. Jeder Browser lädt das Video selbst. Signierte URLs sind für Teilnehmer sichtbar.',synced:'Synchron',waiting:'Warten auf Video',buffering:'Lokaler Puffer',blocked:'Wiedergabe erlauben',failed:'Video nicht verfügbar',error:'Vorgang fehlgeschlagen: {code}',STATE_CHANGED:'Ein anderer Nutzer hat den Status geändert. Der aktuelle Status wurde übernommen.',HOST_ONLY:'Nur der Gastgeber darf steuern.',INVALID_URL:'Gültige HTTP-/HTTPS-URL ohne Zugangsdaten eingeben.',NO_VIDEO:'Zuerst ein Video laden.',MEDIA_ERROR:'Quelle nicht abspielbar. URL, Codec und Zugriff prüfen.',REVISION:'Revision {value}'},\n ru:{title:'Нажмите «Пуск». Смотрите вместе.',lead:'Общая временная шкала, где бы вы ни находились.',online:'Подключено',offline:'Переподключение…',emptyVideo:'Добавьте прямую ссылку на видео.',join:'Разрешить воспроизведение на устройстве',play:'Воспроизвести для всех',pause:'Приостановить для всех',timeline:'Общая позиция воспроизведения',speed:'Скорость',mute:'Выключить звук у себя',unmute:'Включить звук у себя',volume:'Громкость у себя',fullscreen:'Полный экран',participants:'Участники просмотра',host:'Ведущий',you:'Вы',everyone:'Все могут управлять просмотром',hostMode:'Просмотром управляет ведущий',handoff:'Передать роль ведущего',transfer:'Передать управление',lateJoin:'Новые участники автоматически догоняют просмотр. Громкость и разрешение браузера остаются локальными.',source:'Источник видео',url:'Прямая ссылка на видео',placeholder:'https://media.example.com/video.mp4',load:'Загрузить для всех',urlNote:'Используйте доступную браузеру ссылку MP4 / WebM, а не страницу видеосервиса. Всем нужен доступ.',privacy:'Синхронизируется только состояние просмотра. Каждый браузер загружает видео напрямую. Подписанные ссылки видны участникам.',synced:'Синхронизировано',waiting:'Ожидание видео',buffering:'Локальная буферизация',blocked:'Разрешите воспроизведение',failed:'Видео недоступно',error:'Ошибка операции: {code}',STATE_CHANGED:'Другой участник изменил просмотр. Применено актуальное состояние.',HOST_ONLY:'Только ведущий может управлять.',INVALID_URL:'Введите HTTP-/HTTPS-ссылку без логина и пароля.',NO_VIDEO:'Сначала загрузите видео.',MEDIA_ERROR:'Браузер не может воспроизвести источник. Проверьте ссылку, кодек и доступ.',REVISION:'Версия {value}'},\n ja:{title:'再生して、一緒に観よう',lead:'離れていても、同じタイムラインを共有。',online:'接続済み',offline:'再接続中…',emptyVideo:'動画の直接 URL を追加して開始します。',join:'この端末で再生を許可',play:'全員の再生を開始',pause:'全員の再生を停止',timeline:'共有の再生位置',speed:'再生速度',mute:'この端末を消音',unmute:'この端末の消音を解除',volume:'端末の音量',fullscreen:'全画面',participants:'一緒に観ている人',host:'ホスト',you:'あなた',everyone:'全員が再生を操作できます',hostMode:'ホストが再生を操作します',handoff:'ホストを交代',transfer:'操作権を渡す',lateJoin:'途中参加すると自動で追いつきます。音量とブラウザーの再生許可は端末ごとです。',source:'動画ソース',url:'動画の直接 URL',placeholder:'https://media.example.com/video.mp4',load:'全員に読み込む',urlNote:'動画サイトのページではなく、ブラウザーで再生できる MP4 / WebM の直接 URL を使用してください。全員にアクセス権が必要です。',privacy:'同期するのは再生状態だけです。各ブラウザーが動画を直接読み込みます。署名付き URL は参加者に公開されます。',synced:'同期済み',waiting:'動画待ち',buffering:'端末で読み込み中',blocked:'再生を許可してください',failed:'動画を再生できません',error:'操作失敗: {code}',STATE_CHANGED:'ほかの参加者が再生状態を更新しました。最新の状態を適用しました。',HOST_ONLY:'ホストだけが操作できます。',INVALID_URL:'認証情報を含まない HTTP / HTTPS の動画 URL を入力してください。',NO_VIDEO:'先に動画を読み込んでください。',MEDIA_ERROR:'ソースを再生できません。URL、コーデック、アクセス権を確認してください。',REVISION:'状態バージョン {value}'}\n};\n"},"client/index.html":{"encoding":"utf8","data":"<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Watch Together</title><link rel=\"stylesheet\" href=\"./base.css\"><link rel=\"stylesheet\" href=\"./style.css\"><script type=\"module\" src=\"./main.mjs\"></script></head><body><main><header class=\"masthead\"><div><div class=\"eyebrow\">WEBSPEAK · WATCH TOGETHER</div><h1 data-i18n=\"title\"></h1><p data-i18n=\"lead\"></p></div><div id=\"connection\" class=\"connection\"><i></i><span id=\"connection-text\"></span></div></header><div id=\"notice\" class=\"notice\" role=\"status\" hidden></div><div class=\"watch-grid\"><section class=\"card player-card\"><div class=\"stage\"><video id=\"video\" playsinline preload=\"metadata\"></video><div id=\"empty-video\"><span aria-hidden=\"true\">▷</span><p data-i18n=\"emptyVideo\"></p></div><button id=\"join-playback\" class=\"primary\" data-i18n=\"join\" hidden></button></div><div class=\"player-controls\"><div class=\"row\"><button id=\"play\" class=\"primary\" data-i18n=\"play\" disabled></button><span id=\"time\" class=\"time\">0:00 / 0:00</span><span id=\"sync\" class=\"pill\" aria-live=\"polite\"></span></div><label class=\"seek-label\"><span data-i18n=\"timeline\"></span><input id=\"seek\" type=\"range\" min=\"0\" max=\"1\" step=\".1\" value=\"0\" disabled></label><div class=\"row between\"><label><span data-i18n=\"speed\"></span><select id=\"rate\"><option>.25</option><option>.5</option><option>.75</option><option selected>1</option><option>1.25</option><option>1.5</option><option>2</option></select></label><div class=\"row\"><button id=\"mute\" class=\"secondary\" data-i18n=\"mute\"></button><label class=\"volume-label\"><span data-i18n=\"volume\"></span><input id=\"volume\" type=\"range\" min=\"0\" max=\"1\" step=\".05\" value=\".8\"></label><button id=\"fullscreen\" class=\"secondary\" data-i18n=\"fullscreen\"></button></div></div></div></section><aside class=\"card\"><div class=\"row between\"><h2 data-i18n=\"participants\"></h2><span id=\"member-count\" class=\"pill\">0</span></div><p id=\"mode\" class=\"muted\"></p><div id=\"members\"></div><div id=\"handoff\" hidden><label><span data-i18n=\"handoff\"></span><select id=\"next-host\"></select></label><button id=\"handoff-button\" class=\"secondary\" data-i18n=\"transfer\"></button></div><p class=\"footer\" data-i18n=\"lateJoin\"></p><span id=\"revision\" class=\"muted\"></span></aside><section class=\"card source-card\"><h2 data-i18n=\"source\"></h2><form id=\"source-form\"><label><span data-i18n=\"url\"></span><input id=\"url\" type=\"url\" maxlength=\"4096\" required data-placeholder=\"placeholder\" autocomplete=\"off\"></label><button class=\"primary\" id=\"load\" type=\"submit\" data-i18n=\"load\"></button></form><p class=\"footer\" data-i18n=\"urlNote\"></p></section></div><p class=\"footer\" data-i18n=\"privacy\"></p></main></body></html>\n"},"client/main.mjs":{"encoding":"utf8","data":"import {$,translator,request,live,setText} from './platform.mjs';import {copies} from './i18n.mjs';\nconst host=window.webspeak;let context=await host.ready;const words=translator(copies,context),t=words.t,video=$('video');\nlet self='',snapshot=null,online=false,source='',offset=0,bestRtt=Infinity,busy=false,dragging=false,blocked=false,localError=false,disposed=false,lastPlaybackAttempt=0;\nvideo.volume=.8;\nconst position=(s,now)=>Math.max(0,s.position+(s.playing?Math.max(0,now-s.updatedAt)/1000*s.rate:0));\nconst time=value=>{const n=Math.max(0,Math.floor(Number.isFinite(value)?value:0));return n>=3600?Math.floor(n/3600)+':'+String(Math.floor(n/60)%60).padStart(2,'0')+':'+String(n%60).padStart(2,'0'):Math.floor(n/60)+':'+String(n%60).padStart(2,'0');};\nfunction notice(code){$('notice').hidden=!code;$('notice').classList.toggle('error',!!code);$('notice').textContent=code?(copies[context.language]?.[code]??copies.en[code]??t('error',{code})):'';}\nfunction canControl(){return online&&snapshot&&(!snapshot.hostOnly||snapshot.host===self);}\nfunction render(){setText(t);$('connection').dataset.online=String(online);$('connection-text').textContent=t(online?'online':'offline');$('play').textContent=t(snapshot?.state.playing?'pause':'play');$('play').disabled=!canControl()||!snapshot?.state.source||busy;$('rate').disabled=!canControl()||busy;$('load').disabled=!canControl()||busy;$('url').disabled=!canControl();$('seek').disabled=!canControl()||!Number.isFinite(video.duration)||busy;$('mute').textContent=t(video.muted?'unmute':'mute');$('empty-video').hidden=!!source;$('join-playback').hidden=!blocked;$('sync').textContent=t(localError?'failed':blocked?'blocked':!source?'waiting':video.readyState<3?'buffering':'synced');if(!dragging){$('time').textContent=time(video.currentTime)+' / '+time(video.duration);$('seek').max=String(Number.isFinite(video.duration)?video.duration:1);$('seek').value=String(video.currentTime);}if(!snapshot)return;\n $('rate').value=String(snapshot.state.rate);$('revision').textContent=t('REVISION',{value:snapshot.state.revision});$('mode').textContent=t(snapshot.hostOnly?'hostMode':'everyone');$('member-count').textContent=String(snapshot.members.length);$('members').replaceChildren();$('next-host').replaceChildren();for(const p of snapshot.members){const row=document.createElement('div');row.className='peer';const avatar=document.createElement('span');avatar.className='avatar';avatar.textContent=p.nickname.slice(0,1).toLocaleUpperCase();const name=document.createElement('span');name.className='peer-name';name.textContent=p.nickname+(p.id===self?' · '+t('you'):'');row.append(avatar,name);if(p.id===snapshot.host){const badge=document.createElement('span');badge.className='pill';badge.textContent=t('host');row.append(badge);}if(p.id!==self){const option=document.createElement('option');option.value=p.id;option.textContent=p.nickname;$('next-host').append(option);}$('members').append(row);}$('handoff').hidden=self!==snapshot.host||snapshot.members.length<2;\n if(document.activeElement!==$('url'))$('url').value=snapshot.state.source;\n}\nfunction adopt(next){if(snapshot?.state.source!==next.state.source)notice('');if(snapshot&&next.state.revision<snapshot.state.revision)return;snapshot=next;if(!Number.isFinite(bestRtt))offset=next.now-Date.now();apply(true);render();}\nasync function calibrate(){const before=Date.now();try{const result=await request(context,'/clock');const rtt=Date.now()-before;if(rtt<bestRtt){bestRtt=rtt;offset=result.now-(before+rtt/2);}}catch{} }\nfunction apply(force=false){if(!snapshot||disposed)return;const s=snapshot.state;if(s.source!==source){source=s.source;blocked=false;localError=false;video.pause();if(source)video.src=source;else{video.removeAttribute('src');video.load();}if(source)video.load();}\n if(!source||dragging||video.readyState<1||localError)return;const desired=Math.min(Number.isFinite(video.duration)?Math.max(0,video.duration):Infinity,position(s,Date.now()+offset)),drift=desired-video.currentTime;\n if(Math.abs(drift)>1||(force&&Math.abs(drift)>.15))video.currentTime=desired;\n const nudge=s.playing&&Math.abs(drift)>.15&&Math.abs(drift)<1?(drift>0?1.03:.97):1;video.playbackRate=s.rate*nudge;\n if(s.playing&&video.paused&&!video.ended&&!blocked&&performance.now()-lastPlaybackAttempt>1000){lastPlaybackAttempt=performance.now();void video.play().then(()=>{blocked=false;render();}).catch(()=>{blocked=true;render();});}\n else if(!s.playing&&!video.paused)video.pause();\n}\nasync function send(kind,values={}){if(!canControl()||busy)return;busy=true;render();try{const next=await request(context,'/action',{kind,revision:snapshot.state.revision,...values});notice('');adopt(next);}catch(error){if(error.snapshot)adopt(error.snapshot);notice(error.message);}finally{busy=false;render();}}\n$('source-form').addEventListener('submit',event=>{event.preventDefault();void send('source',{url:$('url').value.trim()});});\n$('play').addEventListener('click',()=>{if(!snapshot)return;const restart=!snapshot.state.playing&&(video.ended||video.currentTime>=video.duration-.1);if(!snapshot.state.playing){blocked=false;lastPlaybackAttempt=performance.now();void video.play().catch(()=>{blocked=true;render();});}void send(snapshot.state.playing?'pause':'play',restart?{position:0}:{});});\n$('join-playback').addEventListener('click',()=>{void video.play().then(()=>{blocked=false;notice('');apply(true);render();}).catch(()=>notice('MEDIA_ERROR'));});\n$('seek').addEventListener('input',()=>{dragging=true;$('time').textContent=time(Number($('seek').value))+' / '+time(video.duration);});$('seek').addEventListener('change',()=>{dragging=false;void send('seek',{position:Number($('seek').value)});});\n$('rate').addEventListener('change',()=>void send('rate',{rate:Number($('rate').value)}));$('mute').addEventListener('click',()=>{video.muted=!video.muted;render();});$('volume').addEventListener('input',()=>{video.volume=Number($('volume').value);});$('fullscreen').addEventListener('click',()=>{const stage=video.parentElement;void (document.fullscreenElement?document.exitFullscreen():stage.requestFullscreen()).catch(()=>{});});$('handoff-button').addEventListener('click',()=>void send('handoff',{to:$('next-host').value}));\nvideo.addEventListener('loadedmetadata',()=>{apply(true);render();});video.addEventListener('canplay',()=>{apply(true);render();});video.addEventListener('waiting',render);video.addEventListener('error',()=>{localError=true;notice('MEDIA_ERROR');render();});video.addEventListener('ended',()=>{if(snapshot?.state.playing&&canControl())void send('pause',{position:video.duration});});\nvideo.addEventListener('timeupdate',()=>{if(dragging)return;$('time').textContent=time(video.currentTime)+' / '+time(video.duration);$('seek').max=String(Number.isFinite(video.duration)?video.duration:1);$('seek').value=String(video.currentTime);});\nconst stream=live(context,{online:value=>{online=value;render();},hello:value=>{self=value.self;render();},state:adopt,members:value=>{if(snapshot){snapshot={...snapshot,members:value};render();}}});\nconst correction=setInterval(()=>apply(),1000),clock=setInterval(()=>void calibrate(),30000);void calibrate();host.onContextChange(next=>{context=next;words.change(next);render();});function dispose(){if(disposed)return;disposed=true;clearInterval(correction);clearInterval(clock);stream.close();video.pause();video.removeAttribute('src');video.load();}host.signal.addEventListener('abort',dispose,{once:true});addEventListener('pagehide',dispose,{once:true});render();\n"},"client/platform.mjs":{"encoding":"utf8","data":"export const $=id=>document.getElementById(id);\nexport const formatBytes=value=>{if(value<1024)return value+' B';const unit=Math.min(3,Math.floor(Math.log(value)/Math.log(1024)));return (value/1024**unit).toFixed(unit===1?0:1)+' '+['B','KiB','MiB','GiB'][unit];};\nexport function translator(copies,context){let language=context.language;return {t:(key,values={})=>(copies[language]?.[key]??copies.en[key]??key).replace(/\\{(\\w+)\\}/g,(_,key)=>String(values[key]??'')),change:c=>{language=c.language;}};}\nexport async function request(context,route,body,options={}){\n const controller=new AbortController(),signal=options.signal??window.webspeak.signal;const abort=()=>controller.abort();signal.addEventListener('abort',abort,{once:true});if(signal.aborted)abort();const timer=setTimeout(abort,15000);\n try{const res=await fetch(context.serverUrl+route,{method:body===undefined?'GET':'POST',headers:body===undefined?{}:{'content-type':'application/json'},body:body===undefined?undefined:JSON.stringify(body),credentials:'omit',signal:controller.signal});const value=await res.json();if(!res.ok)throw Object.assign(new Error(value.error??'REQUEST_FAILED'),value);return value;}finally{clearTimeout(timer);signal.removeEventListener('abort',abort);}\n}\nexport function live(context,handlers){const source=new EventSource(context.serverUrl+'/events');for(const [event,handler]of Object.entries(handlers))source.addEventListener(event,e=>{try{handler(JSON.parse(e.data));}catch(error){console.error('Application event rejected',error.message);}});source.onopen=()=>handlers.online?.(true);source.onerror=()=>handlers.online?.(false);const close=()=>source.close();window.webspeak.signal.addEventListener('abort',close,{once:true});addEventListener('pagehide',close,{once:true});return {close};}\nexport function setText(copies){for(const node of document.querySelectorAll('[data-i18n]'))node.textContent=copies(node.dataset.i18n);for(const node of document.querySelectorAll('[data-placeholder]'))node.placeholder=copies(node.dataset.placeholder);}\nexport function download(blob,name){const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),30000);}\n"},"client/style.css":{"encoding":"utf8","data":":root{--accent:#376dce;--soft:#eaf0ff}html[data-theme=dark]{--accent:#9fc1ff;--soft:#233653}.watch-grid{display:grid;grid-template-columns:minmax(0,2.4fr) minmax(220px,1fr);gap:20px;align-items:start}.player-card{padding:0;overflow:hidden}.stage{position:relative;background:#080c13;aspect-ratio:16/9;display:grid;place-items:center}.stage video{width:100%;height:100%;position:absolute;inset:0;object-fit:contain}.stage #empty-video{text-align:center;color:#a0aec4;z-index:1}.stage #empty-video>span{font-size:50px;color:#6e85aa}.stage #join-playback{z-index:2;box-shadow:0 5px 30px #0005}.player-controls{padding:18px}.seek-label{margin:14px 0}.seek-label>span{position:absolute;width:1px;height:1px;overflow:hidden}.player-controls select{width:80px;padding:7px}.player-controls label{gap:4px}.player-controls .secondary{font-size:12px;padding:8px 10px;min-height:34px}.volume-label{width:90px}.volume-label>span{font-size:10px}.time{font-size:11px;font-variant-numeric:tabular-nums;color:var(--muted)}.source-card{grid-column:1/-1}#source-form{display:flex;gap:12px;align-items:end}#source-form label{flex:1}.peer{font-size:12px}.peer .pill{font-size:9px}#handoff{margin-top:18px}#handoff button{margin-top:10px}.stage:fullscreen{aspect-ratio:auto;width:100vw;height:100vh}.stage:fullscreen video{width:100%;height:100%}@media(max-width:760px){.watch-grid{grid-template-columns:minmax(0,1fr)}#source-form{flex-direction:column;align-items:stretch}.player-controls .row{gap:8px}.volume-label{width:65px}}\n"},"server/main.mjs":{"encoding":"utf8","data":"import {readFile,writeFile,rename,unlink} from 'node:fs/promises';import path from 'node:path';import {createHash,randomUUID} from 'node:crypto';\nimport {createHub,assert,jsonBody,reply,AppError} from './transport.mjs';import {positionAt,nextState,sourceUrl} from './state.mjs';\nexport default async function activate({dataDir,events,signal,publicConfig={}}){\n const rooms=new Map(),hostOnly=publicConfig?.control==='host';let stopped=false;\n const hub=createHub({events,signal,onLeave:p=>{const pending=rooms.get(p.scope);if(pending)void pending.then(room=>{if(room.host===p.id){room.host=hub.list(p.scope)[0]?.id??null;publish(room);}}).catch(()=>{});}});\n async function room(scope){assert(!stopped,'STOPPED',503);if(!rooms.has(scope)){assert(rooms.size<64,'ROOM_LIMIT',429);const pending=(async()=>{const filename=path.join(dataDir,createHash('sha256').update(scope).digest('hex')+'.json');let state={revision:0,source:'',position:0,playing:false,rate:1,updatedAt:Date.now()};try{const saved=JSON.parse(await readFile(filename,'utf8'));assert(saved.version===1&&Number.isSafeInteger(saved.state.revision)&&saved.state.revision>=0);if(saved.state.source)sourceUrl(saved.state.source);assert(Number.isFinite(saved.state.position)&&saved.state.position>=0&&[.25,.5,.75,1,1.25,1.5,2].includes(saved.state.rate));state={...state,...saved.state,playing:false,updatedAt:Date.now()};}catch(error){if(error?.code!=='ENOENT')throw new AppError('ROOM_DATA_INVALID',500);}return {scope,filename,state,host:null,queue:Promise.resolve(),lastUsed:Date.now()};})();rooms.set(scope,pending);pending.catch(()=>rooms.delete(scope));}const result=await rooms.get(scope);result.lastUsed=Date.now();return result;}\n function snapshot(r){return {state:r.state,now:Date.now(),host:r.host,hostOnly,members:hub.list(r.scope)};}\n function publish(r){hub.broadcast(r.scope,'state',snapshot(r));}\n async function persist(r,state){const temporary=r.filename+'.'+randomUUID()+'.tmp';try{await writeFile(temporary,JSON.stringify({version:1,state}),{flag:'wx',mode:0o600});await rename(temporary,r.filename);}finally{await unlink(temporary).catch(()=>{});}}\n const timer=setInterval(()=>{for(const [scope,pending]of rooms)void pending.then(r=>{if(!hub.list(scope).length&&Date.now()-r.lastUsed>1800000)rooms.delete(scope);}).catch(()=>{});},60000);timer.unref?.();\n return {handle:hub.handle(async(req,res)=>{\n  const route=new URL(req.url,'http://app.local').pathname,c=hub.context(req);\n  if(req.method==='GET'&&route==='/clock'){reply(res,{now:Date.now()});return;}\n  if(req.method==='GET'&&route==='/events'){const r=await room(c.scope.key),p=hub.join(req,res);if(!r.host)r.host=p.id;hub.emit(p,'hello',{self:p.id});publish(r);return;}\n  assert(req.method==='POST'&&route==='/action','NOT_FOUND',404);const p=hub.peer(req);hub.rate(p,50);const body=await jsonBody(req,10000),r=await room(p.scope);\n  const action=r.queue.then(async()=>{assert(hub.peers.get(p.id)===p,'JOIN_REQUIRED',403);assert(!hostOnly||r.host===p.id,'HOST_ONLY',403);\n   if(body.revision!==r.state.revision){const error=new AppError('STATE_CHANGED',409);error.snapshot=snapshot(r);throw error;}\n   if(body.kind==='handoff'){assert(r.host===p.id,'HOST_ONLY',403);assert(hub.peers.get(body.to)?.scope===p.scope,'PEER_UNAVAILABLE',404);r.host=body.to;publish(r);return snapshot(r);}\n   const next=nextState(r.state,body,Date.now());await persist(r,next);r.state=next;publish(r);return snapshot(r);\n  });r.queue=action.catch(()=>{});reply(res,await action);\n }),async stop(){stopped=true;clearInterval(timer);hub.stop();for(const pending of rooms.values()){const r=await pending.catch(()=>null);if(r){await r.queue;const paused={...r.state,position:positionAt(r.state),playing:false,updatedAt:Date.now()};await persist(r,paused).catch(()=>{});}}rooms.clear();}};\n}\n"},"server/state.mjs":{"encoding":"utf8","data":"import { assert } from './transport.mjs';\nexport const positionAt=(state,now=Date.now())=>Math.max(0,state.position+(state.playing?Math.max(0,now-state.updatedAt)/1000*state.rate:0));\nexport function sourceUrl(value){assert(typeof value==='string'&&value.length<=4096,'INVALID_URL');let url;try{url=new URL(value);}catch{assert(false,'INVALID_URL');}assert(['http:','https:'].includes(url.protocol)&&!url.username&&!url.password,'INVALID_URL');return url.href;}\nexport function nextState(previous,action,now){const state={...previous,position:positionAt(previous,now),updatedAt:now,revision:previous.revision+1};\n switch(action.kind){case 'source':state.source=sourceUrl(action.url);state.playing=false;state.position=0;break;\n case 'play':assert(state.source,'NO_VIDEO');if(action.position!==undefined){assert(Number.isFinite(action.position)&&action.position>=0&&action.position<=604800,'INVALID_POSITION');state.position=action.position;}state.playing=true;break;\n case 'pause':if(action.position!==undefined){assert(Number.isFinite(action.position)&&action.position>=0&&action.position<=604800,'INVALID_POSITION');state.position=action.position;}state.playing=false;break;\n case 'seek':assert(Number.isFinite(action.position)&&action.position>=0&&action.position<=604800,'INVALID_POSITION');state.position=action.position;break;\n case 'rate':assert([.25,.5,.75,1,1.25,1.5,2].includes(action.rate),'INVALID_RATE');state.rate=action.rate;break;\n default:assert(false,'INVALID_ACTION');}return state;\n}\n"},"server/transport.mjs":{"encoding":"utf8","data":"import { randomUUID } from 'node:crypto';\nexport class AppError extends Error { constructor(code,status=400){super(code);this.code=code;this.status=status;} }\nexport const assert=(value,code='INVALID_REQUEST',status=400)=>{if(!value)throw new AppError(code,status);};\nexport async function jsonBody(req,max=100000){let size=0;const chunks=[];for await(const chunk of req){size+=chunk.length;assert(size<=max,'REQUEST_TOO_LARGE',413);chunks.push(chunk);}try{const result=JSON.parse(Buffer.concat(chunks).toString('utf8'));assert(result&&typeof result==='object'&&!Array.isArray(result));return result;}catch(error){if(error instanceof AppError)throw error;throw new AppError('INVALID_JSON');}}\nexport function reply(res,value,status=200){res.writeHead(status,{'content-type':'application/json; charset=utf-8','cache-control':'no-store'});res.end(JSON.stringify(value));}\nexport function createHub({events,signal,onLeave=()=>{},limit=128}){\n const peers=new Map(),listeners=new Map();let stopped=false;\n function context(req){const c=req.webspeak;assert(c?.apiVersion===2&&typeof c.appId==='string'&&typeof c.self?.id==='string'&&typeof c.self.nickname==='string'&&typeof c.scope?.key==='string','CONTEXT_REQUIRED',403);return c;}\n function peer(req){const c=context(req),p=peers.get(c.appId);assert(p&&p.scope===c.scope.key,'JOIN_REQUIRED',403);p.context=c;return p;}\n function emit(p,event,data){if(!p?.res||p.res.destroyed)return;if(p.res.writableLength>256*1024){p.res.destroy();return;}p.res.write(`event: ${event}\\ndata: ${JSON.stringify(data)}\\n\\n`);}\n function list(scope){return [...peers.values()].filter(p=>p.scope===scope).map(p=>({id:p.id,nickname:p.context.self.nickname}));}\n function broadcast(scope,event,data){for(const p of peers.values())if(p.scope===scope)emit(p,event,data);}\n function remove(id){const p=peers.get(id);if(!p)return;peers.delete(id);p.res.end();onLeave(p);broadcast(p.scope,'members',list(p.scope));}\n function join(req,res){const c=context(req);assert(!stopped,'STOPPED',503);assert(peers.has(c.appId)||peers.size<limit,'ROOM_FULL',429);const old=peers.get(c.appId);if(old){peers.delete(old.id);old.res.end();}\n  res.writeHead(200,{'content-type':'text/event-stream','cache-control':'no-store','x-accel-buffering':'no'});res.flushHeaders();const p={id:c.appId,scope:c.scope.key,context:c,res,rateAt:Date.now(),requests:0};peers.set(p.id,p);\n  res.on('close',()=>{if(peers.get(p.id)===p)remove(p.id);});broadcast(p.scope,'members',list(p.scope));return p;\n }\n function rate(p,max=100){const now=Date.now();if(now-p.rateAt>10000){p.rateAt=now;p.requests=0;}assert(++p.requests<=max,'RATE_LIMIT',429);}\n const left=value=>remove(value?.appId),changed=c=>{const p=peers.get(c?.appId);if(!p)return;if(c.scope.key!==p.scope)remove(p.id);else{p.context=c;broadcast(p.scope,'members',list(p.scope));}};\n events.on('participantLeft',left);events.on('contextChanged',changed);\n const timer=setInterval(()=>{for(const p of peers.values())emit(p,'heartbeat',{now:Date.now()});},10000);timer.unref?.();\n function stop(){if(stopped)return;stopped=true;clearInterval(timer);events.off('participantLeft',left);events.off('contextChanged',changed);for(const id of [...peers.keys()])remove(id);listeners.clear();}\n signal.addEventListener('abort',stop,{once:true});\n return {peers,context,peer,emit,broadcast,list,join,remove,rate,stop,id:()=>randomUUID(),handle:handler=>async(req,res)=>{try{await handler(req,res);}catch(error){if(!res.headersSent)reply(res,{error:error instanceof AppError?error.code:'APPLICATION_FAILED',...(error.snapshot?{snapshot:error.snapshot}:{})},error instanceof AppError?error.status:500);else res.end();}}};\n}\n"}}}